### SmartTrust REST API - HTTP Request Collection
### Base URL: http://localhost:5000/api/v1

@baseUrl = http://localhost:5000/api/v1

### 1. Health Check
GET {{baseUrl}}/health
Accept: application/json

### 2. Login - Employee
# @name employeeLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "employee@smarttrust.demo",
  "password": "Demo@1234"
}

### 3. Login - Supervisor
# @name supervisorLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "supervisor@smarttrust.demo",
  "password": "Demo@1234"
}

### 4. Login - Manager
# @name managerLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "manager@smarttrust.demo",
  "password": "Demo@1234"
}

### Store token for subsequent requests
@employeeToken = {{employeeLogin.response.body.data.token}}
@supervisorToken = {{supervisorLogin.response.body.data.token}}
@managerToken = {{managerLogin.response.body.data.token}}

### 5. Get Current User Profile (Auth Me)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{employeeToken}}

### 6. Master Data - Get Machines
GET {{baseUrl}}/machines
Authorization: Bearer {{employeeToken}}

### 7. Master Data - Get Areas
GET {{baseUrl}}/areas
Authorization: Bearer {{employeeToken}}

### 8. Master Data - Get Sanitation Schedules
GET {{baseUrl}}/sanitation-schedules
Authorization: Bearer {{employeeToken}}

### 9. Master Data - Get Products
GET {{baseUrl}}/products
Authorization: Bearer {{employeeToken}}

### 10. Master Data - Get Materials
GET {{baseUrl}}/materials
Authorization: Bearer {{employeeToken}}

### 11. Create Energy Record (Employee)
# @name newEnergyRecord
POST {{baseUrl}}/energy-records
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "machine_id": 1,
  "record_date": "2026-10-25",
  "shift": "MORNING",
  "reading_start_kwh": 35000.0,
  "reading_end_kwh": 35360.0,
  "runtime_hours": 7.5,
  "notes": "Morning pasteurisation shift"
}

### 12. Create Hygiene Record (Employee)
POST {{baseUrl}}/hygiene-records
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "schedule_id": 1,
  "area_id": 1,
  "scheduled_date": "2026-10-25",
  "completed_at": "2026-10-25T06:15:00Z",
  "chemical_used": "Sodium Hydroxide 2%",
  "concentration_percent": 2.0,
  "contact_minutes": 22,
  "checklist_json": "{\"rinse_clear\": true, \"temp_above_70c\": true}",
  "notes": "Routine CIP wash completed on time"
}

### 13. Create Production Record (Employee)
POST {{baseUrl}}/production-records
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "product_id": 1,
  "batch_no": "BATCH-20261025-01",
  "production_date": "2026-10-25",
  "shift": "MORNING",
  "raw_input_qty": 5000.0,
  "actual_output_qty": 4875.0,
  "unit": "LITRE",
  "notes": "Toned milk 1L pouch packaging run"
}

### 14. Create Waste Record (Employee)
POST {{baseUrl}}/waste-records
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "material_id": 1,
  "record_date": "2026-10-25",
  "shift": "MORNING",
  "waste_type": "CLEANING_LOSS",
  "quantity": 30.0,
  "unit": "LITRE",
  "cause": "Line purge residual loss"
}

### 15. Pending Approvals Queue (Supervisor/Manager)
GET {{baseUrl}}/approvals/pending
Authorization: Bearer {{supervisorToken}}

### 16. Request Correction on Record (Supervisor)
POST {{baseUrl}}/approvals/energy/1/decision
Authorization: Bearer {{supervisorToken}}
Content-Type: application/json

{
  "decision": "REQUEST_CORRECTION",
  "comment": "Please verify start meter reading value from log book."
}

### 17. Approve Record (Manager)
POST {{baseUrl}}/approvals/energy/1/decision
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "decision": "APPROVE",
  "comment": "Verified and approved."
}

### 18. View Approval History
GET {{baseUrl}}/approvals/history?record_type=energy&record_id=1
Authorization: Bearer {{managerToken}}

### 19. Dashboard Summary
GET {{baseUrl}}/dashboard/summary
Authorization: Bearer {{managerToken}}

### 20. Dashboard Energy Trend
GET {{baseUrl}}/dashboard/energy-trend
Authorization: Bearer {{managerToken}}

### 21. Dashboard Hygiene Compliance
GET {{baseUrl}}/dashboard/hygiene-compliance
Authorization: Bearer {{managerToken}}

### 22. Dashboard Waste Summary
GET {{baseUrl}}/dashboard/waste-summary
Authorization: Bearer {{managerToken}}

### 23. Alerts List
GET {{baseUrl}}/alerts
Authorization: Bearer {{managerToken}}

### 24. Review Alert (Manager)
POST {{baseUrl}}/alerts/1/review
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "status": "CONFIRMED",
  "comment": "Confirmed anomalous energy draw; maintenance technician scheduled."
}

### 25. Insights & Recommendations
GET {{baseUrl}}/insights/recommendations
Authorization: Bearer {{managerToken}}

### 26. User Management - List Users (Manager Only)
GET {{baseUrl}}/users
Authorization: Bearer {{managerToken}}
